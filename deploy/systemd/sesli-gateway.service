# Sesli asistan — Gateway (santral REST :8000, RTP 10000–10999/udp, arayüz /ui). install.sh kurar.
[Unit]
Description=Sesli asistan Gateway (santral bağlantısı, diyalog, arayüz)
Documentation=https://github.com/Tugbacevikk/sesli-asistan-gateway/blob/main/docs/tasarim.md
After=network-online.target sesli-stt.service ollama.service
Wants=network-online.target sesli-stt.service

[Service]
Type=simple
User=sesli
Group=sesli
WorkingDirectory=/var/lib/sesli-asistan
EnvironmentFile=/etc/sesli-asistan/gateway.env
EnvironmentFile=/etc/sesli-asistan/secrets.env
Environment=LOG_FORMAT=json PYTHONUNBUFFERED=1
ExecStart=@ONEK@/current/venv/gateway/bin/python -m sesli_asistan.gateway
Restart=on-failure
RestartSec=3
TimeoutStartSec=180
# açık çağrılar santrale bırakılır (graceful 10 sn)
TimeoutStopSec=20
LimitNOFILE=65536

StateDirectory=sesli-asistan
CacheDirectory=sesli-asistan
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
