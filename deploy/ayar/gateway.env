# Gateway ayarları (tasarim.md 13). install.sh /etc/sesli-asistan/gateway.env olarak kopyalar; var olanın üzerine
# yazmaz. Gizli değerler (API_KEY, PBX_API_KEY) burada değil, secrets.env'de. Değişince:
#   sudo systemctl restart sesli-gateway
# Anonslar, mesai saatleri ve takma adlar arayüzün Ayarlar sekmesinden de değiştirilebilir (yeniden başlatmasız).

ORGANIZATION_NAME=
GATEWAY_API_HOST=0.0.0.0
GATEWAY_API_PORT=8000

# Santral (tasarim.md 6.2): santralin adresi ve Gateway'e erişebilecek IP'ler (virgülle). Boş: herkes (yalnız deneme)
PBX_BASE_URL=http://SANTRAL_ADRESI:8100
PBX_ALLOWED_IPS=
RTP_HOST=0.0.0.0
RTP_PORT_MIN=10000
RTP_PORT_MAX=10999
MAX_CONCURRENT_CALLS=30

# Bağımlı servisler (aynı sunucuda)
STT_GRPC_ADDR=127.0.0.1:50051
LLM_BACKEND=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3.5:4b
TTS_URL=http://127.0.0.1:5500
TTS_CACHE_DIR=/var/cache/sesli-asistan/tts

# Rehber (Sentra Rehber API gelene kadar JSON dosyası)
DIRECTORY_SOURCE=json
DIRECTORY_PATH=/etc/sesli-asistan/rehber.json

# Mesai (tasarim.md 5.1.3). Boş: her zaman açık
OFFICE_HOURS=
HOLIDAYS=01-01, 04-23, 05-01, 05-19, 07-15, 08-30, 10-29
AFTER_HOURS_MODE=announce
TIMEZONE=Europe/Istanbul

# Kalıcı veriler (/var/lib/sesli-asistan, systemd StateDirectory)
CALL_HISTORY_DB=/var/lib/sesli-asistan/cagri_gecmisi.db
CALL_HISTORY_DAYS=30
LOCAL_SETTINGS_FILE=/var/lib/sesli-asistan/yerel_ayarlar.json

# Arayüz: varsayılan yalnız sunucunun kendisi. Uzaktan erişim nginx (HTTPS) üzerinden: deploy/nginx/
UI_ENABLED=true
UI_ALLOWED_IPS=127.0.0.1,::1
FORWARDED_ALLOW_IPS=127.0.0.1
