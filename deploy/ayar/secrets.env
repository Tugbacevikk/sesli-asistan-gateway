# Gizli değerler. /etc/sesli-asistan/secrets.env — sahip root:sesli, izin 640. Loglara yazılmaz.
# API_KEY'i install.sh rastgele üretir; santral Gateway'e "Authorization: Bearer <API_KEY>" ile gelir.
API_KEY=
# Gateway → santral eylemlerinde gönderilen anahtar (santral ekibinden)
PBX_API_KEY=
# Arayüz kullanıcıları (isteğe bağlı): "ad:rol:anahtar" virgülle; rol yonetici ya da izleyici, anahtar en az 16
# karakter (üretmek: openssl rand -base64 24). Tanımlıysa ayar / rehber değişikliklerinde kişi kaydedilir, izleyici
# değiştiremez ve API_KEY arayüzde yalnız izleyici olur. Arayüz: https://…/ui?anahtar=<kendi anahtarınız>
UI_USERS=
