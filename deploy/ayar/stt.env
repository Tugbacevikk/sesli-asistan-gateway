# STT servisi ayarları (tasarim.md 13). /etc/sesli-asistan/stt.env. Değişince: sudo systemctl restart sesli-stt
STT_HOST=127.0.0.1
STT_PORT=50051
# Motor: sherpa (varsayılan: mihuai/turkish-stt-66m-v2, CPU, GPU gerekmez) | whisper (GPU; modeli ayrıca indirin:
# tools/models/indir.py --model faster-whisper-medium). tasarim.md ADR-021
STT_ENGINE=sherpa
STT_SHERPA_THREADS=2
STT_SHERPA_DIR=@ONEK@/models/turkish-stt-66m-v2
STT_MODEL_DIR=@ONEK@/models/faster-whisper-medium
STT_VAD_MODEL=@ONEK@/models/silero_vad.onnx
STT_DEVICE=auto
STT_BEAM=2
STT_MAX_STREAMS=64
STT_METRICS_PORT=9101
# Teşhis: cümle seslerini diske yazar (kişisel veri!). Üretimde BOŞ kalmalı.
STT_DEBUG_DIR=

# Loglarda arayanın sözü ve cevap metinleri: false → yalnız uzunluk (kişisel veri; çağrı geçmişi ayrıca ayarlanır)
LOG_TEXTS=false
