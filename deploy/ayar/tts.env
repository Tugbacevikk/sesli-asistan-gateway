# Kadın sesi TTS (Seslen, ADR-015) — isteğe bağlı. /etc/sesli-asistan/tts.env
# Kullanmak için gateway.env'de TTS_URL=http://127.0.0.1:5600 yapın. Model ağırlıkları CC BY-SA 4.0.
TTS_SESLEN_HOST=127.0.0.1
TTS_SESLEN_PORT=5600
TTS_SESLEN_VOICE=ayse
# Boş: ilk açılışta Hugging Face'ten indirilir. İnternetsiz sunucuda model klasörünü gösterin.
TTS_SESLEN_MODEL_DIR=
